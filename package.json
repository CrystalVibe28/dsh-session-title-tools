{
  "name": "@crystalvibe28/dsh-session-title-tools",
  "version": "1.3.0",
  "type": "module",
  "description": "Read and rename the current session title with DSH's native title rules, and manage DSH native session-title generation",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "session-title",
    "tool"
  ],
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "dsh": ">=0.2.2-rc.3 <0.3.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CrystalVibe28/dsh-session-title-tools.git"
  },
  "homepage": "https://github.com/CrystalVibe28/dsh-session-title-tools#readme",
  "bugs": {
    "url": "https://github.com/CrystalVibe28/dsh-session-title-tools/issues"
  }
}
